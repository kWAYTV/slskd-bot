# ==============================================================================
# telegram-slskd-local-bot — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For the full reference table, see the README:
#   https://github.com/GeiserX/telegram-slskd-local-bot#environment-variables
# ==============================================================================

# ==============================================================================
# TELEGRAM BOT (required)
# ==============================================================================
# Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Get your ID from @userinfobot on Telegram
# If empty, the bot denies all users until IDs are configured
TELEGRAM_ALLOWED_USERS=

# Comma-separated Telegram user IDs allowed to save into OUTPUT_DIR / run /import
# If empty, all allowed users can save to the library
TELEGRAM_LIBRARY_USERS=

# Optional: URL of a self-hosted Bot API server (github.com/tdlib/telegram-bot-api).
# Raises the bot upload limit from 50MB to 2000MB so hi-res FLAC/WAV are sent
# untouched instead of as OGG previews. Requires TELEGRAM_API_ID/TELEGRAM_API_HASH
# (from https://my.telegram.org) on the telegram-bot-api container — see
# docker-compose.yml (profile "local-api"). Leave empty to use the cloud API.
TELEGRAM_API_BASE_URL=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# BOT_API_DATA_PATH=./telegram-bot-api

# ==============================================================================
# SPOTIFY API (required)
# ==============================================================================
# Create an app at https://developer.spotify.com/dashboard
# Uses Client Credentials flow (no user login needed)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ==============================================================================
# SLSKD CONNECTION (required)
# ==============================================================================
# URL of your slskd instance (e.g., http://192.168.1.100:5030)
SLSKD_HOST=http://localhost:5030

# API key from slskd settings (Settings > Security > API Keys)
SLSKD_API_KEY=your_api_key_here

# ==============================================================================
# PATHS
# ==============================================================================
# Where slskd stores completed downloads (inside container)
DOWNLOAD_DIR=/downloads

# Where to place the final renamed files (inside container)
OUTPUT_DIR=/music

# Persistent SQLite directory for download history and playlist imports
DATA_DIR=/data

# Host paths for Docker volume mounts
# SLSKD_DOWNLOAD_PATH=/mnt/user/appdata/slskd/downloads
# MUSIC_OUTPUT_PATH=/mnt/user/Multimedia/MusicaSergio/WCYR-FLAC

# ==============================================================================
# DOWNLOAD BEHAVIOR
# ==============================================================================

# Cap simultaneous slskd transfers
MAX_CONCURRENT_DOWNLOADS=3

# Discard unapproved downloads after this many seconds (min 60)
APPROVAL_TTL_SECS=86400

# Maximum number of search results to show
MAX_RESULTS=5

# Duration tolerance when matching Spotify duration (seconds)
# Lower = stricter matching, higher = more flexible
DURATION_TOLERANCE_SECS=5

# How long to wait for slskd search results (seconds)
SEARCH_TIMEOUT_SECS=30

# How long to wait for a download to complete (seconds)
DOWNLOAD_TIMEOUT_SECS=600

# Keywords in filenames that indicate unwanted versions
# Comma-separated, case-insensitive
EXCLUDE_KEYWORDS=live,remix,acoustic,karaoke,instrumental,cover,demo,radio edit,tribute,remaster

# Output filename template
# Available variables: {artist}, {title}
FILENAME_TEMPLATE={artist} - {title}

# ==============================================================================
# LOGGING & HEALTH
# ==============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Health check HTTP port
HEALTH_PORT=8080
